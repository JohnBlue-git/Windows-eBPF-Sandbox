# eBPF for Windows release used by both steps. Change it only here.
# CMakeLists.txt downloads the headers (source tarball of the tag);
# winvm/build-image.sh downloads the Release build zip and installs its MSI in
# the VM image. The standalone .msi release asset is not used: its eBPFCore.sys
# is built native-only and rejects JIT programs (netsh: error 129).
EBPF_FOR_WINDOWS_VERSION=1.7.0
EBPF_FOR_WINDOWS_SOURCE_SHA256=7608251c5717d1b845dcec44e9b508e22918b52f21ea771d0f0b29f44be2c35d
EBPF_FOR_WINDOWS_BUILD_ZIP_SHA256=b0e2e974c146d265b66eb42011547b20e9a7a79a44c403bce1c12939bbaf56c4
